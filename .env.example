# --- Server ---
PORT=3000
# CRITICAL: this must be an address your STUDENTS' PHONES can actually reach —
# not "localhost" (that only means "this computer" to the phone itself).
# For real-life use, run `ngrok http 3000` and paste the https URL it gives you here.
# See the README "Getting reachable from a phone" section — this is the #1 cause
# of "the QR doesn't open" problems.
BASE_URL=https://your-ngrok-url-or-real-domain-here

# --- Firebase ---
# Path to the Firebase service account JSON key file (see README for setup steps)
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=./firebase-service-account.json

# --- Anti-sharing: geofencing ---
# Classroom GPS coordinates (center point). Get these once from Google Maps (right-click > coordinates).
CLASSROOM_LAT=30.7333
CLASSROOM_LNG=76.7794
# How far (meters) from the classroom center a scan is still accepted.
# Account for GPS drift indoors - 25-40m is usually safe for a single room.
CLASSROOM_RADIUS_METERS=30

# --- Anti-sharing: network (WiFi) check ---
# Comma-separated list of allowed public IPs and/or CIDR ranges for your
# classroom/school WiFi, e.g. "103.21.58.10" or "103.21.58.0/24,198.51.100.7".
# To find yours: connect to that WiFi and search "what is my ip" in a browser.
# Leave this BLANK to disable the network check (e.g. if your school's IP isn't
# stable) — geofencing + roster + one-time-use + device-lock still apply.
ALLOWED_NETWORK_IPS=
